{
  "name": "steward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Steward \u2014 multi-program grantmaking platform on Cloudflare",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "migrate:local": "wrangler d1 migrations apply steward-preview --local",
    "migrate:preview": "wrangler d1 migrations apply steward-preview --remote",
    "dev": "wrangler dev --env=\"\"",
    "seed:build": "esbuild scripts/buildSeed.ts --bundle --platform=node --format=esm --outfile=.seedbuild.mjs --log-level=warning && node .seedbuild.mjs && rm -f .seedbuild.mjs",
    "seed:preview": "wrangler d1 execute steward-preview --remote --file=seeds/inspire-change.sql",
    "seed:local": "wrangler d1 execute steward-preview --local --file=seeds/inspire-change.sql",
    "admin:sql": "esbuild scripts/buildAdmins.ts --bundle --platform=node --format=esm --outfile=.adminbuild.mjs --log-level=warning && node .adminbuild.mjs",
    "admin:apply": "wrangler d1 execute steward-preview --remote --file=seeds/admins.sql",
    "deploy:preview": "wrangler deploy --env=\"\"",
    "check:config": "esbuild scripts/checkConfig.ts --bundle --platform=node --format=esm --outfile=.cfgcheck.mjs --log-level=warning && node .cfgcheck.mjs && rm -f .cfgcheck.mjs",
    "verify": "npm run check:config && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.20.1",
    "fflate": "^0.8.3",
    "typescript": "^5.7.3",
    "vitest": "~3.2.7",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "read-excel-file": "^9.3.10"
  }
}
